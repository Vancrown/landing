# ── Resend (email sending) ──
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx
# The email address that will receive contact form messages
RESEND_TO_EMAIL=you@example.com
# The "From" address for emails (must be verified in Resend)
# Use your own domain after domain verification in Resend:
# RESEND_FROM_EMAIL=Contact Form <noreply@yourdomain.com>
RESEND_FROM_EMAIL=Contact Form <onboarding@resend.dev>

# ── Public contact info (NEXT_PUBLIC_* are exposed to the browser) ──
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com
NEXT_PUBLIC_GITHUB_URL=https://github.com/your-username
NEXT_PUBLIC_TWITTER_URL=https://twitter.com/your-username
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/in/your-username
